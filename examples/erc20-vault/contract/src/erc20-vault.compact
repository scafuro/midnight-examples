//                                        ⚠️ CAUTION ⚠️
// This is an example application for educational and experimental purposes.
// Use at your own risk and expect rapid iteration.
//
// ERC20 Cross-Chain Vault: a Signet client contract that moves ERC20 value between an
// EVM chain and shielded tokens on Midnight, with the Signet Distributed MPC network
// executing the EVM side. See ../../README.md for the full integration walkthrough.
//
// Contention: flushQueue is the ONLY circuit that reads or writes globalLastSeen.
// Every other circuit touches only entries keyed by its own request, so user calls
// never conflict with each other or with a flush. See ../docs/contention-handling.md.
//
// Layout: configuration, then the request queue every action shares, then one section
// per action holding its request types, its ledger fields and its circuits.

pragma language_version >= 0.25;

import CompactStandardLibrary;

// Resolved through node_modules via COMPACT_PATH (see the compile scripts in package.json).
import "@sig-net/midnight/src/Signet";

// ==== Configuration ==================================================================

// The Signet singleton the send circuits cross-contract call to notify the MPC.
sealed ledger signetSigner: SignetSigner;

// Verifies every attestation (the Signet singleton emits MPC posts unverified).
export ledger mpcResponseKey: Secp256k1Point;

export ledger vaultMaxFeePerGas: Uint<128>;
export ledger vaultMaxPriorityFeePerGas: Uint<128>;

struct VaultGasLimits {
  withdraw: Uint<64>;
  approve: Uint<64>;
  swap: Uint<64>;
  supply: Uint<64>;
  redeem: Uint<64>;
}
export ledger vaultGasLimits: VaultGasLimits;

// Set once initialise() has run.
export ledger initialised: Boolean;

// The vault's own EVM address (derivation path "vault"), the enforced deposit recipient.
export ledger vaultEvmAddress: Bytes<20>;

// EIP-155 chain id of the ONE Ethereum network this vault operates on, set by initialise().
export ledger evmChainId: Uint<64>;
export ledger mpcKeyVersion: Uint<8>;

// Identity commitment of the deployer. Only they may call initialise().
sealed ledger deployer: Bytes<32>;

// The pinned Uniswap SwapRouter02.
export ledger uniswapRouter: Bytes<20>;

// The pinned Aave USDC pair: underlying ERC20 + its ERC-4626 wrapper (stataUSDC).
export ledger stataUnderlying: Bytes<20>;
export ledger stataToken: Bytes<20>;

circuit requireInitialised(): [] {
  assert(initialised, "Not initialised");
}

// Exported pure circuits exist so off-chain code reads these values from the compiled
// circuit, never a TS re-declaration.

// The ERC20 transfer result schema, used in both directions (output and respond).
export pure circuit vaultResponseSchema(): Bytes<34> {
  return "[{\"name\":\"success\",\"type\":\"bool\"}]" as Bytes<34>;
}

// vaultResponseSchema()'s output decoded: transfer()'s bool, packed by the MPC to 1 byte.
struct VaultResponse {
  success: Boolean;
}

// Each ERC20 gets its own shielded token colour. transientHash is pinned by the
// chain's ledger era: coins minted before a fork that changes it need a migration.
export pure circuit vaultTokenDomainSeparator(erc20Address: Bytes<20>): Bytes<32> {
  return upgradeFromTransient(transientHash<Vector<2, Bytes<32>>>([
    pad(32, "erc20:vault:"),
    erc20Address as Field as Bytes<32>
  ]));
}

witness callerSecretKey(): Bytes<32>;

// Identity commitment, doubling as the MPC key-derivation path of deposit requests. A
// transientHash change at a fork re-keys derived accounts and orphans pinned commitments.
export pure circuit userCommitment(sk: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<Vector<2, Bytes<32>>>([pad(32, "vault:user:"), sk]));
}

// Pins WHO may configure. Everything needing the contract's own address waits for
// initialise().
constructor(
  deployerCommitment: Bytes<32>,
  signetContract: SignetSigner,
) {
  deployer = disclose(deployerCommitment);
  signetSigner = disclose(signetContract);
}

// One-shot, deployer-gated post-deploy configuration: the derived values need the
// contract's own address, and the gate stops front-running the configuration.
export circuit initialise(
  vaultEvm: Bytes<20>,
  swapRouter: Bytes<20>,
  stataUnderlyingAddr: Bytes<20>,
  stataTokenAddr: Bytes<20>,
  chainId: Uint<64>,
  responseKey: Secp256k1Point,
  responseKeyVersion: Uint<8>,
  evmHeight: Uint<64>
): [] {
  assert(!initialised, "Already initialised");
  assert(responseKeyVersion >= 1, "keyVersion must be >= 1");
  assert(userCommitment(callerSecretKey()) == deployer, "Not the deployer");
  assert(chainId > 0 as Uint<64>, "Chain ID must be positive");
  assert(swapRouter as Field != 0 as Field, "Router cannot be zero");
  assert(stataUnderlyingAddr as Field != 0 as Field, "stataUnderlying cannot be zero");
  assert(stataTokenAddr as Field != 0 as Field, "stataToken cannot be zero");
  initialised = true;
  vaultEvmAddress = disclose(vaultEvm);
  uniswapRouter = disclose(swapRouter);
  stataUnderlying = disclose(stataUnderlyingAddr);
  stataToken = disclose(stataTokenAddr);
  evmChainId = disclose(chainId);
  mpcResponseKey = disclose(responseKey);
  mpcKeyVersion = disclose(responseKeyVersion);
  globalLastSeen = disclose(evmHeight);

  vaultMaxFeePerGas = 150000000000 as Uint<128>;
  vaultMaxPriorityFeePerGas = 1000000000 as Uint<128>;

  vaultGasLimits = VaultGasLimits {
    withdraw: 100000 as Uint<64>,
    approve: 100000 as Uint<64>,
    swap: 700000 as Uint<64>,
    supply: 500000 as Uint<64>,
    redeem: 500000 as Uint<64>
  };
}

export circuit setGasParams(
  newMaxFeePerGas: Uint<128>,
  newMaxPriorityFeePerGas: Uint<128>,
  newWithdrawGasLimit: Uint<64>,
  newApproveGasLimit: Uint<64>,
  newSwapGasLimit: Uint<64>,
  newSupplyGasLimit: Uint<64>,
  newRedeemGasLimit: Uint<64>
): [] {
  requireInitialised();
  assert(userCommitment(callerSecretKey()) == deployer, "Not the deployer");

  assert(newMaxFeePerGas > 0 as Uint<128>, "maxFeePerGas must be positive");
  assert(
    newMaxPriorityFeePerGas <= newMaxFeePerGas,
    "maxPriorityFeePerGas cannot exceed maxFeePerGas"
  );
  assert(newWithdrawGasLimit > 0 as Uint<64>, "Gas limit must be positive");
  assert(newApproveGasLimit > 0 as Uint<64>, "Gas limit must be positive");
  assert(newSwapGasLimit > 0 as Uint<64>, "Gas limit must be positive");
  assert(newSupplyGasLimit > 0 as Uint<64>, "Gas limit must be positive");
  assert(newRedeemGasLimit > 0 as Uint<64>, "Gas limit must be positive");

  vaultMaxFeePerGas = disclose(newMaxFeePerGas);
  vaultMaxPriorityFeePerGas = disclose(newMaxPriorityFeePerGas);
  vaultGasLimits = VaultGasLimits {
    withdraw: disclose(newWithdrawGasLimit),
    approve: disclose(newApproveGasLimit),
    swap: disclose(newSwapGasLimit),
    supply: disclose(newSupplyGasLimit),
    redeem: disclose(newRedeemGasLimit)
  };
}

// ==== Request queue ==================================================================
// Every action runs the same six steps: start, flush the request, send, queue the
// attestation, flush the attestation, complete. This section holds the machinery the
// steps share. Each action's own section holds its start, send and complete circuits.

// `reserved` keeps the enum at two variants: a one-variant enum in a hashed struct
// compiles to a field element the ledger parses as zero bytes, and proofs then fail
// the proof server's alignment check.
export enum Action { deposit, reserved }

// The EIP-1559 fee envelope of a request's EVM transaction, fixed at start.
export struct GasParams {
  gasLimit: Uint<64>;
  maxFeePerGas: Uint<128>;
  maxPriorityFeePerGas: Uint<128>;
}

// Everything the flush needs of a request, at one size for every action: the action's
// own arguments live in its args map under inIndex, and argsHash commits to them.
export struct RequestBufferEntry {
  action: Action;
  // false: evmNonce is the caller's own nonce, taken verbatim.
  nonceIsVault: Boolean;
  evmNonce: Uint<64>;
  // The key of the entry in inputRequestBuffer and of its args in the action's args
  // map, public already.
  inIndex: Uint<64>;
  // ownershipCommitment(inIndex, callerSecretKey()), proven at complete.
  commitment: Bytes<32>;
  argsHash: Bytes<32>;
}

export struct OutputRequestEntry {
  entry: RequestBufferEntry;
  // globalLastSeen when the flush moved the entry: every attestation settling it
  // must come from a strictly higher block.
  lastSeen: Uint<64>;
}

// A verified attestation, stored under its request id. The complete circuit re-supplies
// the serialised output and checks it against the digest, so the record holds no output
// and serves every output width.
export struct AttestationRecord {
  blockHeight: Uint<64>;
  outputKind: OutputKind;
  digest: Bytes<32>;
}

export enum FlushChannel { empty, request, attestation }

export struct FlushSlot {
  channel: FlushChannel;
  inIndex: Uint<64>;       // read when channel == request
  requestId: RequestId;    // read when channel == attestation
}

// The highest block height of any attestation the flush has folded.
export ledger globalLastSeen: Uint<64>;

export ledger inputRequestBuffer: Map<Uint<64>, RequestBufferEntry>;
export ledger outputRequestBuffer: Map<Bytes<32>, OutputRequestEntry>;
export ledger inputAttestationBuffer: Map<RequestId, AttestationRecord>;
export ledger outputAttestationBuffer: Map<RequestId, AttestationRecord>;

// Request id -> the outputRequestBuffer key it was sent from. The send circuits write
// here, never to an output buffer.
export ledger evictionMap: Map<RequestId, Bytes<32>>;

// Pinned into every buffered request and proven at complete. Deliberately NOT
// userCommitment: reuse would link a request's ownership to its depositor identity.
// Before a fork that changes transientHash, every open request must be settled.
export pure circuit ownershipCommitment(inIndex: Uint<64>, sk: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<[Bytes<32>, Uint<64>, Bytes<32>]>([
    pad(32, "vault:request:"),
    inIndex,
    sk
  ]));
}

// The outputRequestBuffer key: every buffered field that determines the EVM
// transaction, and NOT the commitment. Identical requests therefore share a key, so the
// second cannot be flushed until the first is settled, by which point the first one's
// attestation height is folded into globalLastSeen and bounds the second one's
// lastSeen. A fork that changes transientHash re-keys twins across it: drain open
// requests first.
export pure circuit requestKey(entry: RequestBufferEntry): Bytes<32> {
  return upgradeFromTransient(transientHash<[Bytes<32>, Action, Boolean, Uint<64>, Bytes<32>]>([
    pad(32, "vault:request:key"),
    entry.action,
    entry.nonceIsVault,
    entry.evmNonce,
    entry.argsHash
  ]));
}

// Permissionless. Slots run in order: a request slot sees the heights of the
// attestation slots before it.
export circuit flushQueue(slots: Vector<10, FlushSlot>): [] {
  requireInitialised();
  for (const slot of slots) {
    const disclosedSlot = disclose(slot);
    if (disclosedSlot.channel == FlushChannel.request) {
      flushRequest(disclosedSlot.inIndex);
    } else if (disclosedSlot.channel == FlushChannel.attestation) {
      flushAttestation(disclosedSlot.requestId);
    }
  }
}

// A slot naming an index that is not queued is a no-op. So is one whose twin (same
// requestKey) is still open: the twin stays queued until the open request settles.
// The twin check must precede the remove, as a skipped slot commits whatever ran.
circuit flushRequest(inIndex: Uint<64>): [] {
  if (!inputRequestBuffer.member(inIndex)) {
    return;
  }
  const entry = inputRequestBuffer.lookup(inIndex);
  const outKey = requestKey(entry);
  if (outputRequestBuffer.member(outKey)) {
    return;
  }
  inputRequestBuffer.remove(inIndex);
  outputRequestBuffer.insert(outKey, OutputRequestEntry {
    entry: entry,
    lastSeen: globalLastSeen,
  });
}

// A slot naming a request id with no queued attestation is a no-op.
circuit flushAttestation(requestId: RequestId): [] {
  if (!inputAttestationBuffer.member(requestId)) {
    return;
  }
  const record = inputAttestationBuffer.lookup(requestId);
  inputAttestationBuffer.remove(requestId);
  if (record.blockHeight > globalLastSeen) {
    globalLastSeen = record.blockHeight;
  }
  outputAttestationBuffer.insert(requestId, record);
}

circuit recordAttestation(
  respondBidirectionalEvent: RespondBidirectionalEventV1,
  digest: Bytes<32>
): [] {
  const requestId = respondBidirectionalEvent.requestId;
  assert(evictionMap.member(requestId), "Request not sent");
  const outKey = evictionMap.lookup(requestId);
  assert(outputRequestBuffer.member(outKey), "Request not open");
  const out = outputRequestBuffer.lookup(outKey);
  assert(respondBidirectionalEvent.blockHeight > out.lastSeen, "Stale attestation");
  assert(!inputAttestationBuffer.member(requestId), "Attestation already queued");
  assert(!outputAttestationBuffer.member(requestId), "Attestation already flushed");
  inputAttestationBuffer.insert(requestId, AttestationRecord {
    blockHeight: respondBidirectionalEvent.blockHeight,
    outputKind: respondBidirectionalEvent.outputKind,
    digest: digest,
  });
}

// Queues an attestation with an empty output (a failed or unviable execution). The
// output is needed here, as the signed digest binds the height to it and the flush
// trusts the height it folds.
export circuit queueAttestation0(
  respondBidirectionalEvent: RespondBidirectionalEventV1,
  serializedOutput: Bytes<0>
): [] {
  requireInitialised();
  const attestation = disclose(respondBidirectionalEvent);
  const output = disclose(serializedOutput);
  assert(
    verifyRespondBidirectionalEventV1<0>(output, attestation, mpcResponseKey),
    "Invalid attestation signature"
  );
  const digest = calculateSignetAttestationDigestV1<0>(
    attestation.requestId, attestation.blockHeight, attestation.outputKind, output
  );
  recordAttestation(attestation, digest);
}

// Queues an attestation with a 1-byte output (the ERC20 transfer bool). The output is
// needed here, as the signed digest binds the height to it and the flush trusts the
// height it folds.
export circuit queueAttestation1(
  respondBidirectionalEvent: RespondBidirectionalEventV1,
  serializedOutput: Bytes<1>
): [] {
  requireInitialised();
  const attestation = disclose(respondBidirectionalEvent);
  const output = disclose(serializedOutput);
  assert(
    verifyRespondBidirectionalEventV1<1>(output, attestation, mpcResponseKey),
    "Invalid attestation signature"
  );
  const digest = calculateSignetAttestationDigestV1<1>(
    attestation.requestId, attestation.blockHeight, attestation.outputKind, output
  );
  recordAttestation(attestation, digest);
}

// Consumes the open request and the flushed attestation that settles it, for the
// action's complete circuit, which removes the action's own event and args. The height
// check is the absolute safety bound: the attestation's block must be strictly above
// every height the vault had folded when it flushed the request.
circuit settleRequest(
  requestId: RequestId,
  action: Action
): [RequestBufferEntry, AttestationRecord] {
  assert(evictionMap.member(requestId), "Request not sent");
  const outKey = evictionMap.lookup(requestId);
  assert(outputRequestBuffer.member(outKey), "Request not open");
  const out = outputRequestBuffer.lookup(outKey);
  assert(out.entry.action == action, "Wrong action");

  assert(outputAttestationBuffer.member(requestId), "Attestation not flushed");
  const record = outputAttestationBuffer.lookup(requestId);
  assert(record.blockHeight > out.lastSeen, "Stale attestation");

  assert(
    out.entry.commitment == ownershipCommitment(out.entry.inIndex, callerSecretKey()),
    "Not the requester"
  );

  evictionMap.remove(requestId);
  outputAttestationBuffer.remove(requestId);
  outputRequestBuffer.remove(outKey);
  return [out.entry, record];
}

// ==== Deposit ========================================================================
// transfer(vaultEvmAddress, amount) on the ERC20, signed by the MPC with the
// depositor's derived account at the depositor's own nonce and gas.

export struct DepositRequest {
  erc20Address: Bytes<20>;
  amount: Uint<128>;
}

export struct DepositArgs {
  request: DepositRequest;
  // userCommitment of the depositor: the MPC derivation path of the account that
  // signs the deposit's EVM transaction.
  path: Bytes<32>;
  gas: GasParams;
}

// Deposit requests (2-word ERC20 transfer, 34-byte schemas).
// Compiled path for MPC notification: [1, 12] (read from managed/erc20-vault/compiler/contract-info.json).
export ledger bidirectionalDepositMap: SignBidirectionalEventMapV1<EvmType2TxParams<2, 0, 0>, 34, 34>;

// inIndex -> the arguments of the deposit queued under it, from start to complete.
export ledger depositArgsMap: Map<Uint<64>, DepositArgs>;

circuit depositArgsHash(args: DepositArgs): Bytes<32> {
  return upgradeFromTransient(transientHash<[Bytes<32>, DepositArgs]>([
    pad(32, "vault:deposit:args"),
    args
  ]));
}

// Queues the deposit under inIndex, a caller-chosen random index. The caller chooses
// their account's nonce and gas: that account signs and pays.
export circuit startDeposit(
  inIndex: Uint<64>,
  evmNonce: Uint<64>,
  gas: GasParams,
  depositRequest: DepositRequest
): [] {
  requireInitialised();
  assert(depositRequest.erc20Address as Field != 0 as Field, "ERC20 address cannot be zero");
  assert(depositRequest.amount > 0 as Uint<128>, "Amount must be positive");
  // completeDeposit mints via a Uint<64> API, so reject unclaimable amounts.
  assert(depositRequest.amount <= 18446744073709551615 as Uint<128>, "Amount exceeds Uint<64> max");
  assert(gas.gasLimit > 0 as Uint<64>, "Gas limit must be positive");

  const disclosedIndex = disclose(inIndex);
  assert(
    !inputRequestBuffer.member(disclosedIndex) && !depositArgsMap.member(disclosedIndex),
    "Index already in use"
  );

  const args = disclose(DepositArgs {
    request: depositRequest,
    path: userCommitment(callerSecretKey()),
    gas: gas,
  });
  depositArgsMap.insert(disclosedIndex, args);
  inputRequestBuffer.insert(disclosedIndex, disclose(RequestBufferEntry {
    action: Action.deposit,
    nonceIsVault: false,
    evmNonce: evmNonce,
    inIndex: inIndex,
    commitment: ownershipCommitment(inIndex, callerSecretKey()),
    argsHash: depositArgsHash(args),
  }));
}

// Records the flushed deposit's SignBidirectionalEvent and notifies the MPC.
// Permissionless: the entry and its args fix every byte of the EVM transaction, so a
// second send of the same entry names the same request id and is refused.
export circuit sendDeposit(outKey: Bytes<32>): [] {
  requireInitialised();
  const disclosedKey = disclose(outKey);
  assert(outputRequestBuffer.member(disclosedKey), "Request not flushed");
  const entry = outputRequestBuffer.lookup(disclosedKey).entry;
  assert(entry.action == Action.deposit, "Wrong action");
  const args = depositArgsMap.lookup(entry.inIndex);
  // The pinned recipient stops a client having the MPC sign a transfer to themselves.
  const calldata = EvmCalldata<2> {
    selector: Bytes [0xa9, 0x05, 0x9c, 0xbb], // transfer(address,uint256)
    noWords: 2 as Uint<16>,
    words: [
      evmAddressAbiWord(vaultEvmAddress),
      numericAbiWord(args.request.amount),
    ]
  };
  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: entry.evmNonce,
    maxPriorityFeePerGas: args.gas.maxPriorityFeePerGas,
    maxFeePerGas: args.gas.maxFeePerGas,
    gasLimit: args.gas.gasLimit,
    to: args.request.erc20Address,
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };
  const schema = vaultResponseSchema();
  const request = constructSignBidirectionalEventV1<EvmType2TxParams<2, 0, 0>, 34, 34>(
    mpcKeyVersion, kernel.self(), args.path,
    MPCSignatureAlgorithm.ecdsa, TxParamType.evmType2, txParams, ethereumCaip2Id(),
    MPCDestination.unused, pad(64, ""), schema, schema
  );
  const requestId = calculateEvmType2RequestIdV1<2, 0, 0, 34, 34>(request);
  assert(!bidirectionalDepositMap.member(requestId), "Request already sent");
  bidirectionalDepositMap.insert(requestId, request);
  evictionMap.insert(requestId, disclosedKey);

  // Notify the MPC (bidirectionalDepositMap's compiled ledger path, [1, 12]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(), 2 as Uint<8>, [1, 12, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// Settles a deposit on either verdict. Executed: checks the output against the
// attestation, then mints the deposited amount when the transfer returned true. Failed
// or unviable: nothing was surrendered, so it only closes the request, and
// serializedOutput is ignored. Depositor-gated, one settle per request. mintNonce must
// be caller-chosen RANDOM: one derived from the (public) requestId would link the
// minted coin to the deposit.
export circuit completeDeposit(
  requestId: RequestId,
  serializedOutput: Bytes<1>,
  mintNonce: Bytes<32>,
  recipient: Maybe<Either<ZswapCoinPublicKey, ContractAddress>>,
): [] {
  requireInitialised();
  const disclosedId = disclose(requestId);
  const settled = settleRequest(disclosedId, Action.deposit);
  const entry = settled[0];
  const record = settled[1];
  const args = depositArgsMap.lookup(entry.inIndex);
  depositArgsMap.remove(entry.inIndex);
  assert(bidirectionalDepositMap.member(disclosedId), "Request event missing");
  bidirectionalDepositMap.remove(disclosedId);

  if (record.outputKind == OutputKind.executed) {
    const output = disclose(serializedOutput);
    assert(
      calculateSignetAttestationDigestV1<1>(
        disclosedId, record.blockHeight, record.outputKind, output
      ) == record.digest,
      "Output does not match the attestation"
    );
    if (deserialize<VaultResponse, 1>(output).success) {
      const claimRecipient = disclose(recipient).is_some
        ? disclose(recipient).value
        : left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
      mintShieldedToken(
        vaultTokenDomainSeparator(args.request.erc20Address),
        args.request.amount as Uint<64>,
        disclose(mintNonce),
        claimRecipient
      );
    }
  }
}

// ==== Withdraw =======================================================================
// transfer(destEvmAddress, amount) on the ERC20, signed by the MPC with the vault's own
// account at a nonce the flush assigns, under the vault's gas settings.

export struct WithdrawRequest {
  erc20Address: Bytes<20>;
  amount: Uint<128>;
  destEvmAddress: Bytes<20>;
}

export struct WithdrawArgs {
  request: WithdrawRequest;
  gas: GasParams;
}

// inIndex -> the arguments of the withdrawal queued under it, from start to complete.
export ledger withdrawArgsMap: Map<Uint<64>, WithdrawArgs>;
